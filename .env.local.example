NEXT_PUBLIC_SOLANA_NETWORK=devnet

# NextAuth.js configuration
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google Auth (optional)
GOOGLE_CLIENT_ID=
